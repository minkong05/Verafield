POSTGRES_USER=tapak
POSTGRES_PASSWORD=tapak
POSTGRES_DB=tapak
DATABASE_URL=postgresql+psycopg://tapak:tapak@db:5432/tapak

# Feature 11 (authentication). JWT_SECRET_KEY has no default in code on
# purpose — generate a real one per environment, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-0000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_HOURS=12
